{
	"name": "@thermarthae/react-smartlist",
	"version": "4.0.1",
	"license": "MIT",
	"author": "thermarthae <thermarthae@protonmail.com>",
	"type": "module",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./*": {
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		}
	},
	"packageManager": "yarn@4.12.0+sha512.f45ab632439a67f8bc759bf32ead036a1f413287b9042726b7cc4818b7b49e14e9423ba49b18f9e06ea4941c1ad062385b1d8760a8d5091a1a31e5f6219afca8",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/thermarthae/react-smartlist.git"
	},
	"bugs": {
		"url": "https://github.com/thermarthae/react-smartlist/issues"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"react",
		"virtual",
		"virtualized",
		"list",
		"smartlist",
		"infinite"
	],
	"scripts": {
		"build": "rolldown -c rolldown.config.ts",
		"lint": "eslint ./src --cache",
		"test": "vitest"
	},
	"dependencies": {
		"scheduler": ">0.23.0",
		"shallow-equal": "^3.1.0"
	},
	"peerDependencies": {
		"@types/react": "*",
		"react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
	},
	"peerDependenciesMeta": {
		"@types/react": {
			"optional": true
		}
	},
	"devDependencies": {
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@thermarthae/eslint-config": "^7.0.1",
		"@types/node": "^25.0.10",
		"@types/react": "^19.2.9",
		"@types/react-dom": "^19.2.3",
		"@types/scheduler": "^0.26.0",
		"@vitejs/plugin-react": "^5.1.2",
		"eslint": "^9.39.2",
		"happy-dom": "^20.3.7",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"rolldown": "1.0.0-rc.1",
		"rolldown-plugin-dts": "^0.21.5",
		"typescript": "^5.9.3",
		"vite": "8.0.0-beta.9",
		"vitest": "^4.0.18"
	},
	"resolutions": {
		"vitest/vite": "8.0.0-beta.9"
	}
}
